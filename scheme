/* =========================================================
   USER PROFILE
   ========================================================= */

let userProfile = {};
let currentResults = [];


/* =========================================================
   PAGE NAVIGATION
   ========================================================= */

function showPage(pageId) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* =========================================================
   RADIO VALUE HELPER
   ========================================================= */

function getRadioValue(name) {

    const selected =
        document.querySelector(
            'input[name="' + name + '"]:checked'
        );

    return selected ? selected.value : "";
}


/* =========================================================
   MATCHING ENGINE
   ========================================================= */

function calculateMatch(scheme, profile) {

    let score = 45;

    /* Need is the strongest signal */

    if (profile.need === scheme.category) {
        score += 32;
    }

    /* Occupation */

    if (
        scheme.category === "farmer" &&
        profile.occupation === "farmer"
    ) {
        score += 14;
    }

    if (
        scheme.category === "business" &&
        (
            profile.occupation === "business" ||
            profile.occupation === "self" ||
            profile.occupation === "artisan"
        )
    ) {
        score += 12;
    }

    if (
        scheme.category === "employment" &&
        (
            profile.occupation === "unemployed" ||
            profile.unemployed === "yes"
        )
    ) {
        score += 12;
    }

    if (
        scheme.category === "education" &&
        profile.occupation === "student"
    ) {
        score += 12;
    }

    if (
        scheme.category === "women" &&
        profile.gender === "female"
    ) {
        score += 14;
    }

    if (
        scheme.category === "health" &&
        profile.disability === "yes"
    ) {
        score += 8;
    }

    /* Social category */

    if (
        profile.category === "sc" ||
        profile.category === "st"
    ) {
        if (
            scheme.id === 33 ||
            scheme.id === 34 ||
            scheme.id === 35 ||
            scheme.id === 49 ||
            scheme.id === 50
        ) {
            score += 12;
        }
    }

    /* Orphan / family support */

    if (
        profile.orphan === "yes" &&
        scheme.category === "social"
    ) {
        score += 10;
    }

    /* Rural */

    if (
        profile.rural === "yes" &&
        (
            scheme.category === "farmer" ||
            scheme.category === "employment" ||
            scheme.category === "social"
        )
    ) {
        score += 5;
    }

    /* Age signals */

    if (
        profile.age >= 18 &&
        scheme.category === "employment"
    ) {
        score += 4;
    }

    if (
        profile.age >= 18 &&
        scheme.category === "business"
    ) {
        score += 4;
    }

    /* Women + girl-child related schemes */

    if (
        profile.gender === "female" &&
        (
            scheme.id === 15 ||
            scheme.id === 16 ||
            scheme.id === 17 ||
            scheme.id === 40 ||
            scheme.id === 41
        )
    ) {
        score += 10;
    }

    return Math.min(99, score);
}


/* =========================================================
   FORM SUBMISSION
   ========================================================= */

document.getElementById("schemeForm").addEventListener(
    "submit",
    function(event) {

        event.preventDefault();

        userProfile = {

            name:
                document.getElementById("name").value,

            email:
                document.getElementById("email").value,

            age:
                Number(document.getElementById("age").value),

            gender:
                document.getElementById("gender").value,

            state:
                document.getElementById("state").value,

            category:
                document.getElementById("category").value,

            income:
                document.getElementById("income").value,

            parents:
                getRadioValue("parents"),

            orphan:
                document.getElementById("orphan").value,

            dependents:
                document.getElementById("dependents").value,

            occupation:
                document.getElementById("occupation").value,

            need:
                document.getElementById("need").value,

            disability:
                document.getElementById("disability").value,

            unemployed:
                document.getElementById("unemployed").value,

            rural:
                document.getElementById("rural").value

        };


        currentResults = schemes
            .map(scheme => ({
                ...scheme,
                match: calculateMatch(scheme, userProfile)
            }))
            .sort((a, b) => b.match - a.match)
            .slice(0, 5);


        renderResults();

        showPage("resultsPage");

    }
);


/* =========================================================
   RESULTS
   ========================================================= */

function renderResults() {

    const list =
        document.getElementById("resultList");

    const greeting =
        document.getElementById("resultGreeting");

    greeting.textContent =
        "Schemes that may match you, " +
        userProfile.name.split(" ")[0];


    list.innerHTML = "";


    currentResults.forEach((scheme, index) => {

        let matchClass = "match-medium";

        if (scheme.match >= 80) {
            matchClass = "match-high";
        }

        if (scheme.match < 60) {
            matchClass = "match-low";
        }


        const card =
            document.createElement("div");

        card.className = "scheme-card";


        card.innerHTML = `

            <div>

                <div class="scheme-code">
                    MATCH ${String(index + 1).padStart(2, "0")}
                    • ${scheme.code}
                </div>

                <h3>${scheme.name}</h3>

                <p>
                    ${scheme.description}
                </p>

                <div class="scheme-tags">

                    <span class="scheme-tag">
                        ${scheme.category}
                    </span>

                    <span class="scheme-tag">
                        Government scheme
                    </span>

                    <span class="scheme-tag">
                        Explore eligibility
                    </span>

                </div>

            </div>


            <div class="match-box">

                <div class="match-percent ${matchClass}">
                    ${scheme.match}%
                </div>

