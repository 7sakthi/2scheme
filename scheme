<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Jansahayak | Government Scheme Finder</title>

<style>

/* =========================================================
   JANSAHAYAK
   Government Scheme Discovery Prototype
   ========================================================= */

:root {
    --saffron: #e87518;
    --saffron-dark: #c95f0c;
    --green: #16833a;
    --green-dark: #0e642b;
    --navy: #243746;
    --charcoal: #29323a;
    --text: #30363b;
    --muted: #69747c;
    --border: #dfe4e7;
    --cream: #faf9f6;
    --white: #ffffff;
    --light-green: #edf7f0;
    --light-orange: #fff5eb;
    --success: #157a35;
    --warning: #b76b00;
    --shadow: 0 10px 30px rgba(28, 43, 53, 0.08);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--cream);
    color: var(--text);
    line-height: 1.6;
}

/* =========================================================
   TOP GOVERNMENT BAR
   ========================================================= */

.top-strip {
    height: 5px;
    background: linear-gradient(
        to right,
        var(--saffron) 0%,
        var(--saffron) 33.33%,
        #ffffff 33.33%,
        #ffffff 66.66%,
        var(--green) 66.66%,
        var(--green) 100%
    );
}

.gov-bar {
    background: #f4f5f3;
    border-bottom: 1px solid #e1e4e2;
    padding: 8px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #596168;
}

.gov-left {
    display: flex;
    align-items: center;
    gap: 8px;
}

.emblem-mini {
    width: 20px;
    height: 20px;
    border: 1px solid #777;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 9px;
    font-weight: bold;
    color: #555;
}

/* =========================================================
   MAIN NAVIGATION
   ========================================================= */

.navbar {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    min-height: 78px;
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo-area {
    display: flex;
    align-items: center;
    gap: 14px;
}

.logo-mark {
    width: 45px;
    height: 45px;
    border: 2px solid var(--navy);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #fff;
}

.logo-mark::before {
    content: "✦";
    font-size: 23px;
    color: var(--saffron);
}

.logo-text h1 {
    font-family: Georgia, serif;
    font-size: 24px;
    color: var(--navy);
    letter-spacing: 0.5px;
}

.logo-text p {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
    text-transform: uppercase;
}

.nav-links {
    display: flex;
    gap: 8px;
}

.nav-links button {
    background: transparent;
    border: none;
    padding: 10px 15px;
    color: #4f5b63;
    cursor: pointer;
    font-size: 14px;
}

.nav-links button:hover {
    color: var(--saffron-dark);
}

/* =========================================================
   PAGE CONTAINERS
   ========================================================= */

.page {
    display: none;
    min-height: calc(100vh - 120px);
}

.page.active {
    display: block;
}

.container {
    width: min(1120px, 92%);
    margin: auto;
}

/* =========================================================
   HOME PAGE
   ========================================================= */

.hero {
    padding: 70px 0 45px;
    background:
        radial-gradient(circle at 85% 15%, rgba(232,117,24,0.08), transparent 28%),
        radial-gradient(circle at 10% 80%, rgba(22,131,58,0.07), transparent 30%),
        var(--cream);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 55px;
    align-items: center;
}

.official-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    background: #f2f4f3;
    border: 1px solid #dce1de;
    border-radius: 3px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #59645d;
    margin-bottom: 22px;
}

.official-label span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
}

.hero h2 {
    font-family: Georgia, serif;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.08;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 20px;
}

.hero h2 strong {
    color: var(--saffron-dark);
    font-weight: 600;
}

.hero-description {
    max-width: 650px;
    font-size: 17px;
    color: #5e6970;
    margin-bottom: 30px;
}

.hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.primary-btn {
    background: var(--saffron);
    color: white;
    border: none;
    padding: 14px 26px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    border-radius: 3px;
    transition: 0.2s;
}

.primary-btn:hover {
    background: var(--saffron-dark);
    transform: translateY(-1px);
}

.secondary-btn {
    background: white;
    color: var(--navy);
    border: 1px solid #ccd2d5;
    padding: 14px 26px;
    cursor: pointer;
    font-size: 14px;
    border-radius: 3px;
}

.secondary-btn:hover {
    border-color: var(--green);
}

/* Hero information panel */

.hero-panel {
    background: white;
    border: 1px solid var(--border);
    border-top: 4px solid var(--green);
    box-shadow: var(--shadow);
    padding: 28px;
}

.hero-panel h3 {
    font-family: Georgia, serif;
    font-size: 21px;
    margin-bottom: 22px;
    color: var(--navy);
}

.info-line {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 14px 0;
    border-bottom: 1px solid #edf0f1;
}

.info-line:last-child {
    border-bottom: none;
}

.info-number {
    min-width: 28px;
    height: 28px;
    border: 1px solid var(--saffron);
    color: var(--saffron-dark);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 12px;
    font-weight: bold;
}

.info-line strong {
    display: block;
    font-size: 14px;
}

.info-line span {
    font-size: 12px;
    color: var(--muted);
}

/* =========================================================
   TRUST SECTION
   ========================================================= */

.trust-section {
    background: white;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 35px 0;
}

.trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.trust-item {
    text-align: center;
    padding: 15px;
}

.trust-item .symbol {
    font-size: 27px;
    margin-bottom: 8px;
}

.trust-item strong {
    display: block;
    color: var(--navy);
    font-size: 14px;
}

.trust-item span {
    font-size: 12px;
    color: var(--muted);
}

/* =========================================================
   FORM PAGE
   ========================================================= */

.form-page {
    background: #f6f7f5;
    padding: 45px 0 80px;
}

.page-heading {
    margin-bottom: 32px;
}

.page-heading .eyebrow {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--green-dark);
    text-transform: uppercase;
    font-weight: 700;
}

.page-heading h2 {
    font-family: Georgia, serif;
    color: var(--navy);
    font-size: 35px;
    font-weight: 500;
    margin: 7px 0;
}

.page-heading p {
    color: var(--muted);
    font-size: 14px;
}

/* Progress */

.progress-wrapper {
    background: white;
    border: 1px solid var(--border);
    padding: 17px 20px;
    margin-bottom: 25px;
}

.progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 9px;
    color: var(--muted);
}

.progress-track {
    height: 5px;
    background: #e8ebeb;
}

.progress-bar {
    height: 100%;
    width: 25%;
    background: linear-gradient(to right, var(--saffron), var(--green));
    transition: 0.4s;
}

/* FORM */

.form-card {
    background: white;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 35px;
}

.form-section {
    margin-bottom: 38px;
}

.form-section:last-child {
    margin-bottom: 10px;
}

.form-section-title {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #e4e7e8;
    padding-bottom: 13px;
    margin-bottom: 24px;
}

.section-number {
    width: 29px;
    height: 29px;
    background: var(--navy);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 12px;
    font-weight: bold;
}

.form-section-title h3 {
    font-family: Georgia, serif;
    font-size: 20px;
    color: var(--navy);
    font-weight: 500;
}

.form-section-title p {
    font-size: 11px;
    color: var(--muted);
}

/*
   IMPORTANT:
   All fields are vertical.
   No side-by-side categories/gender cards.
*/

.field {
    margin-bottom: 22px;
}

.field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 7px;
    color: #3c454b;
}

.required {
    color: #b33b22;
}

.field input,
.field select {
    width: 100%;
    height: 47px;
    padding: 0 13px;
    border: 1px solid #cfd6d9;
    background: #fff;
    color: #30383e;
    font-size: 14px;
    border-radius: 2px;
    outline: none;
    transition: 0.2s;
}

.field input:focus,
.field select:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(22,131,58,0.08);
}

.field small {
    display: block;
    margin-top: 5px;
    color: #7b858b;
    font-size: 11px;
}

.radio-group {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.radio-option {
    border: 1px solid #d7dcde;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    background: #fff;
    transition: 0.15s;
}

.radio-option:hover {
    border-color: var(--green);
    background: #fafdfb;
}

.radio-option input {
    accent-color: var(--green);
}

.form-footer {
    border-top: 1px solid var(--border);
    padding-top: 25px;
    margin-top: 35px;
    display: flex;
    justify-content: flex-end;
}

/* =========================================================
   RESULTS PAGE
   ========================================================= */

.results-page {
    background: #f7f5f1;
    padding: 45px 0 80px;
}

.results-header {
    background: var(--navy);
    color: white;
    padding: 35px;
    margin-bottom: 25px;
    position: relative;
    overflow: hidden;
}

.results-header::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    border: 35px solid rgba(255,255,255,0.04);
    border-radius: 50%;
    right: -70px;
    top: -90px;
}

.results-header .eyebrow {
    color: #f1a76a;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

.results-header h2 {
    font-family: Georgia, serif;
    font-weight: 500;
    font-size: 34px;
    margin: 5px 0;
}

.results-header p {
    color: #cbd2d6;
    font-size: 14px;
}

.result-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.scheme-card {
    background: white;
    border: 1px solid var(--border);
    padding: 23px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 25px;
    transition: 0.2s;
}

.scheme-card:hover {
    border-color: #bcc6ca;
    box-shadow: 0 7px 25px rgba(28,43,53,0.08);
    transform: translateY(-2px);
}

.scheme-code {
    font-size: 10px;
    color: var(--green-dark);
    letter-spacing: 1px;
    font-weight: 700;
    text-transform: uppercase;
}

.scheme-card h3 {
    font-family: Georgia, serif;
    color: var(--navy);
    font-size: 21px;
    font-weight: 600;
    margin: 5px 0 7px;
}

.scheme-card p {
    color: var(--muted);
    font-size: 13px;
    max-width: 720px;
}

.scheme-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 13px;
}

.scheme-tag {
    font-size: 10px;
    background: #f0f3f1;
    border: 1px solid #dfe5e1;
    color: #4e5b54;
    padding: 4px 8px;
}

.match-box {
    min-width: 110px;
    text-align: center;
    border-left: 1px solid #e3e6e7;
    padding-left: 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.match-percent {
    font-size: 27px;
    font-weight: 800;
    line-height: 1;
}

.match-high {
    color: var(--green);
}

.match-medium {
    color: var(--warning);
}

.match-low {
    color: #9b4c3d;
}

.match-label {
    font-size: 10px;
    color: #737c82;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin: 5px 0 13px;
}

.view-btn {
    background: white;
    border: 1px solid var(--navy);
    color: var(--navy);
    padding: 8px 13px;
    cursor: pointer;
    font-size: 11px;
    font-weight: 600;
}

.view-btn:hover {
    background: var(--navy);
    color: white;
}

/* =========================================================
   SCHEME DETAIL PAGE
   ========================================================= */

.detail-page {
    background: #f8f8f6;
    padding: 40px 0 80px;
}

.back-button {
    border: none;
    background: none;
    color: var(--green-dark);
    cursor: pointer;
    font-size: 13px;
    margin-bottom: 20px;
}

.detail-hero {
    background: var(--navy);
    color: white;
    padding: 42px;
    border-left: 7px solid var(--saffron);
}

.detail-hero .code {
    color: #f1ad78;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.detail-hero h2 {
    font-family: Georgia, serif;
    font-size: 35px;
    font-weight: 500;
    margin: 7px 0 10px;
}

.detail-hero p {
    color: #d0d7da;
    max-width: 850px;
    font-size: 14px;
}

.detail-layout {
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 20px;
}

.detail-content {
    background: white;
    border: 1px solid var(--border);
    padding: 32px;
}

.detail-section {
    margin-bottom: 33px;
}

.detail-section:last-child {
    margin-bottom: 0;
}

.detail-section h3 {
    font-family: Georgia, serif;
    color: var(--navy);
    font-size: 21px;
    font-weight: 500;
    padding-bottom: 10px;
    border-bottom: 2px solid #edf0ef;
    margin-bottom: 13px;
}

.detail-section h3::after {
    content: "";
    display: block;
    width: 45px;
    height: 2px;
    background: var(--saffron);
    position: relative;
    top: 12px;
}

.detail-section p {
    color: #5c676d;
    font-size: 14px;
}

.detail-section ul {
    list-style: none;
}

.detail-section li {
    position: relative;
    padding: 8px 0 8px 22px;
    color: #555f65;
    font-size: 13px;
    border-bottom: 1px solid #f0f1f1;
}

.detail-section li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: bold;
}

.detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.action-box {
    background: white;
    border: 1px solid var(--border);
    padding: 24px;
}

.action-box h3 {
    font-family: Georgia, serif;
    color: var(--navy);
    margin-bottom: 13px;
}

.apply-btn {
    width: 100%;
    border: none;
    background: var(--green);
    color: white;
    padding: 13px;
    cursor: pointer;
    font-weight: 600;
    margin-top: 13px;
}

.apply-btn:hover {
    background: var(--green-dark);
}

.match-summary {
    text-align: center;
    background: var(--light-green);
    border: 1px solid #d4e9da;
    padding: 20px;
}

.match-summary .number {
    font-size: 35px;
    color: var(--green-dark);
    font-weight: 800;
}

.match-summary span {
    display: block;
    font-size: 11px;
    color: #52715b;
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
    background: #27343d;
    color: #d7dee1;
    padding: 35px 0 25px;
    border-top: 5px solid var(--saffron);
}

.footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
}

footer h3 {
    color: white;
    font-family: Georgia, serif;
    font-weight: 500;
    margin-bottom: 8px;
}

footer p {
    font-size: 12px;
    color: #aeb9be;
}

.footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
    margin-top: 25px;
    padding-top: 17px;
    font-size: 11px;
    color: #9ca8ad;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 850px) {

    .nav-links {
        display: none;
    }

    .hero-grid {
        grid-template-columns: 1fr;
    }

    .trust-grid {
        grid-template-columns: 1fr;
    }

    .detail-layout {
        grid-template-columns: 1fr;
    }

    .scheme-card {
        grid-template-columns: 1fr;
    }

    .match-box {
        border-left: none;
        border-top: 1px solid #e3e6e7;
        padding: 17px 0 0;
        flex-direction: row;
        align-items: center;
        gap: 10px;
    }

    .match-label {
        margin: 0;
    }

    .form-card {
        padding: 22px;
    }

    .detail-hero {
        padding: 28px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 500px) {

    .gov-bar {
        padding: 7px 4%;
    }

    .navbar {
        padding: 0 4%;
    }

    .container {
        width: 92%;
    }

    .hero {
        padding-top: 45px;
    }

    .hero h2 {
        font-size: 38px;
    }

    .hero-panel {
        padding: 20px;
    }

    .results-header h2 {
        font-size: 27px;
    }

    .detail-hero h2 {
        font-size: 27px;
    }
}

</style>
</head>


<body>

<div class="top-strip"></div>

<!-- =====================================================
     GOVERNMENT-STYLE UTILITY BAR
     ===================================================== -->

<div class="gov-bar">
    <div class="gov-left">
        <div class="emblem-mini">भारत</div>
        <span>भारत सरकार • Government of India</span>
    </div>

    <div>
        Public Service Information Portal
    </div>
</div>


<!-- =====================================================
     NAVIGATION
     ===================================================== -->

<nav class="navbar">

    <div class="logo-area">

        <div class="logo-mark"></div>

        <div class="logo-text">
            <h1>Jansahayak</h1>
            <p>Government Scheme Discovery</p>
        </div>

    </div>

    <div class="nav-links">

        <button onclick="showPage('homePage')">
            Home
        </button>

        <button onclick="showPage('formPage')">
            Find Schemes
        </button>

        <button onclick="showPage('homePage')">
            About
        </button>

    </div>

</nav>


<!-- =====================================================
     HOME PAGE
     ===================================================== -->

<section id="homePage" class="page active">

    <div class="hero">

        <div class="container">

            <div class="hero-grid">

                <div>

                    <div class="official-label">
                        <span></span>
                        Public Benefit Scheme Discovery
                    </div>

                    <h2>
                        Find the support
                        <strong>you may be eligible for.</strong>
                    </h2>

                    <p class="hero-description">
                        Jansahayak helps citizens discover relevant
                        government schemes by understanding their
                        age, income, social category, family situation,
                        occupation and other requirements.
                    </p>

                    <div class="hero-actions">

                        <button
                            class="primary-btn"
                            onclick="showPage('formPage')">
                            Find My Schemes →
                        </button>

                        <button
                            class="secondary-btn"
                            onclick="document.getElementById('how').scrollIntoView()">
                            How it works
                        </button>

                    </div>

                </div>


                <div class="hero-panel">

                    <h3>How Jansahayak works</h3>

                    <div class="info-line">
                        <div class="info-number">01</div>
                        <div>
                            <strong>Tell us about yourself</strong>
                            <span>
                                Answer a few simple questions.
                            </span>
                        </div>
                    </div>

                    <div class="info-line">
                        <div class="info-number">02</div>
                        <div>
                            <strong>We analyse your profile</strong>
                            <span>
                                Your answers are compared with scheme
                                requirements.
                            </span>
                        </div>
                    </div>

                    <div class="info-line">
                        <div class="info-number">03</div>
                        <div>
                            <strong>Explore your matches</strong>
                            <span>
                                See your five strongest matches and
                                understand why they may be relevant.
                            </span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>


